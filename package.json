{
  "name": "odontofyapi_node",
  "version": "1.0.0",
  "description": "API backend para Odontofy en Node + Express + TypeScript",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:database": "vitest run --config vitest.database.config.ts",
    "db:up": "docker compose -f compose.database.yml up -d --wait",
    "db:down": "docker compose -f compose.database.yml down",
    "db:migrate": "sequelize-cli db:migrate --env development",
    "db:migrate:test": "sequelize-cli db:migrate --env test",
    "db:rollback:test": "sequelize-cli db:migrate:undo --env test",
    "db:seed:test": "sequelize-cli db:seed:all --env test",
    "db:seed:undo:test": "sequelize-cli db:seed:undo:all --env test",
    "db:rebuild:test": "npm run db:seed:undo:test && sequelize-cli db:migrate:undo:all --env test && npm run db:migrate:test && npm run db:seed:test",
    "db:verify:test": "npm run db:migrate:test && npm run db:seed:test && npm run test:database && npm run db:rebuild:test && npm run test:database",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "packageManager": "npm@11.12.1",
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.13",
    "@types/node": "^24.13.3",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/yamljs": "^0.2.34",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^16.1.0",
    "prettier": "^3.5.3",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.32.1",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@getbrevo/brevo": "^3.0.1",
    "@google-cloud/storage": "^7.21.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.3.1",
    "express": "^4.22.2",
    "express-validator": "^7.0.1",
    "google-auth-library": "^9.15.1",
    "googleapis": "^148.0.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "moment-timezone": "^0.6.0",
    "multer": "^2.2.0",
    "mysql2": "^3.23.2",
    "sequelize": "^6.37.8",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0"
  }
}
